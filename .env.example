# Copy to .env and fill in. Only EXPO_PUBLIC_* values reach the app bundle, so never put secrets here.

# development | preview | production. Non-production builds get a suffixed bundle id and name,
# so a dev build and the store build can sit side by side on one phone.
APP_VARIANT=development

# Shown in the Health Connect permission dialog and required by both stores before release.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
